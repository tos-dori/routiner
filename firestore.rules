rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validState(value) {
      return value is map
        && value.get('routines', []) is list
        && value.get('routines', []).size() > 0;
    }

    function validLegacyMain(data) {
      return data.keys().hasAll(['tag', 'app', 'schema', 'storageKey', 'appVersion', 'dayStartHour', 'updatedAt', 'serverUpdatedAt', 'updatedBy', 'activeRun', 'activeRunUpdatedAt', 'state', 'stateHash'])
        && data.keys().hasOnly(['tag', 'app', 'schema', 'storageKey', 'appVersion', 'dayStartHour', 'updatedAt', 'serverUpdatedAt', 'updatedBy', 'activeRun', 'activeRunUpdatedAt', 'state', 'stateHash'])
        && data.tag == 'ROUTINER_FIRESTORE_STATE_V1'
        && data.app == 'routiner'
        && data.schema in [1, 2, 3]
        && data.storageKey == 'personal_routine_v01'
        && data.appVersion is string
        && data.dayStartHour is int
        && data.updatedAt is number
        && data.serverUpdatedAt is timestamp
        && data.updatedBy is string
        && (data.activeRun == null || data.activeRun is map)
        && data.activeRunUpdatedAt is number
        && validState(data.state)
        && data.stateHash is string;
    }

    function validMain(data) {
      return data.keys().hasAll(['tag', 'app', 'schema', 'storageKey', 'appVersion', 'dayStartHour', 'updatedAt', 'serverUpdatedAt', 'updatedBy', 'activeRun', 'activeRunUpdatedAt', 'state', 'stateHash', 'revision', 'operation'])
        && data.keys().hasOnly(['tag', 'app', 'schema', 'storageKey', 'appVersion', 'dayStartHour', 'updatedAt', 'serverUpdatedAt', 'updatedBy', 'activeRun', 'activeRunUpdatedAt', 'state', 'stateHash', 'revision', 'operation'])
        && data.tag == 'ROUTINER_FIRESTORE_STATE_V1'
        && data.app == 'routiner'
        && data.schema == 4
        && data.storageKey == 'personal_routine_v01'
        && data.appVersion is string
        && data.dayStartHour is int
        && data.updatedAt is number
        && data.serverUpdatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() <= 64
        && (data.activeRun == null || data.activeRun is map)
        && data.activeRunUpdatedAt is number
        && validState(data.state)
        && data.stateHash is string
        && data.stateHash.size() <= 64
        && data.revision is int
        && data.revision >= 1
        && data.operation is string
        && data.operation.size() <= 64;
    }

    function validPrivateDefaults(data) {
      return data.keys().hasAll(['tag', 'schema', 'routines', 'defaultsHash', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['tag', 'schema', 'routines', 'defaultsHash', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.tag == 'ROUTINER_PRIVATE_DEFAULTS_V1'
        && data.schema == 1
        && data.routines is list
        && data.routines.size() > 0
        && data.defaultsHash is string
        && data.defaultsHash.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy is string;
    }

    function validHistory(data) {
      return data.keys().hasAll(['tag', 'schema', 'state', 'stateHash', 'archivedRevision', 'operation', 'archivedAt', 'archivedBy'])
        && data.keys().hasOnly(['tag', 'schema', 'state', 'stateHash', 'archivedRevision', 'operation', 'archivedAt', 'archivedBy'])
        && data.tag == 'ROUTINER_RECOVERY_V2'
        && data.schema == 2
        && validState(data.state)
        && data.stateHash is string
        && data.stateHash.size() <= 64
        && data.archivedRevision is int
        && data.archivedRevision >= 0
        && data.operation is string
        && data.archivedAt is timestamp
        && data.archivedBy is string;
    }

    function validConflict(data) {
      return data.keys().hasAll(['tag', 'schema', 'state', 'stateHash', 'baseRevision', 'baseHash', 'observedRevision', 'observedHash', 'operation', 'createdAt', 'updatedBy'])
        && data.keys().hasOnly(['tag', 'schema', 'state', 'stateHash', 'baseRevision', 'baseHash', 'observedRevision', 'observedHash', 'operation', 'createdAt', 'updatedBy'])
        && data.tag == 'ROUTINER_CONFLICT_V1'
        && data.schema == 1
        && validState(data.state)
        && data.stateHash is string
        && data.stateHash.size() <= 64
        && data.baseRevision is int
        && data.baseHash is string
        && data.observedRevision is int
        && data.observedHash is string
        && data.operation is string
        && data.createdAt is timestamp
        && data.updatedBy is string;
    }

    match /users/{uid}/routiner/main {
      allow read: if owner(uid);
      allow create: if owner(uid) && (validLegacyMain(request.resource.data) || validMain(request.resource.data));
      allow update: if owner(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeRun', 'activeRunUpdatedAt'])
          && (request.resource.data.activeRun == null || request.resource.data.activeRun is map)
          && request.resource.data.activeRunUpdatedAt is number)
        || (resource.data.get('schema', 0) < 4 && validLegacyMain(request.resource.data))
        || (validMain(request.resource.data)
          && request.resource.data.revision == resource.data.get('revision', 0) + 1)
      );
      allow delete: if false;

      match /history/{slotId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && slotId.matches('slot-(0[0-9]|[1-4][0-9])')
          && validHistory(request.resource.data);
        allow delete: if false;
      }

      match /conflicts/{conflictId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && conflictId.matches('[A-Za-z0-9_-]{1,64}')
          && validConflict(request.resource.data);
        allow delete: if owner(uid);
      }
    }

    match /users/{uid}/routiner/private-defaults {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validPrivateDefaults(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
